// part: setup_query

// DSE's hybrid calendar parses 0002-01-01 as 0001-12-30. Year 0002 keeps the
// result representable by the validation timestamp comparator.
CREATE TABLE test_timestamp (
    idx INT PRIMARY KEY,
    res TIMESTAMP
);

INSERT INTO test_timestamp (idx, res) VALUES (1, '2023-05-15 13:45:30.1+0000');
INSERT INTO test_timestamp (idx, res) VALUES (2, '2000-01-01 00:00:00.2+0000');
INSERT INTO test_timestamp (idx, res) VALUES (3, '1969-07-20 20:17:40.3+0000');
INSERT INTO test_timestamp (idx, res) VALUES (4, '0002-01-01 00:00:00.0+0000');
INSERT INTO test_timestamp (idx, res) VALUES (5, '9999-12-31 23:59:59.9+0000');
INSERT INTO test_timestamp (idx, res) VALUES (6, NULL);

