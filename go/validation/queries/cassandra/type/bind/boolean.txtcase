// part: metadata

[tags]
sql-type-name = "BOOLEAN"

// part: setup_query

CREATE TABLE test_boolean (
    idx INT PRIMARY KEY,
    res BOOLEAN
);

// part: bind_query

INSERT INTO test_boolean (idx, res) VALUES ($1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "b",
            "flags": ["nullable"]
        }
    ]
}

// part: bind

{"idx": 0, "res": true}
{"idx": 1, "res": false}
{"idx": 2, "res": null}

// part: query

SELECT res FROM test_boolean
