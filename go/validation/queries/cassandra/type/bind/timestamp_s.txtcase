// part: metadata

sort-keys = [["res", "ascending"]]

// part: setup_query

CREATE TABLE test_timestamp (
    idx INT PRIMARY KEY,
    res TIMESTAMP
);

// part: bind_query

INSERT INTO test_timestamp (idx, res) VALUES ($1, $2)

// part: query

SELECT res FROM test_timestamp

// part: expected_schema

// We can bind multiple timestamp units, but Cassandra reads them back as timestamp[ms].
{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": null}
{"res": -62135596800000}
{"res": 946684800000}
{"res": 1684158330000}
{"res": 253402300799000}
