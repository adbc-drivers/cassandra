// part: metadata

[setup]
drop = "test_map_text_int"

[tags]
sql-type-name = "MAP"
caveats = ["The order of entries within a map value is not deterministic: the underlying gocql driver unmarshals a CQL map into a Go map, whose iteration order is randomized. All keys and values are returned correctly, but two identical queries may return a map's entries in a different order."]

// part: setup_query

CREATE TABLE test_map_text_int (
    pk INT,
    idx INT,
    res MAP<TEXT, INT>,
    PRIMARY KEY (pk, idx)
);

// part: bind_query

INSERT INTO test_map_text_int (pk, idx, res) VALUES (0, $1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "+m",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "key",
                    "format": "u",
                    "flags": []
                },
                {
                    "name": "value",
                    "format": "i",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: bind

{"idx": 1, "res": {"x": 10}}
{"idx": 2, "res": {"only": 1}}
{"idx": 3, "res": null}

// part: query

SELECT res FROM test_map_text_int WHERE pk = 0

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+m",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "key",
                    "format": "u",
                    "flags": []
                },
                {
                    "name": "value",
                    "format": "i",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": {"x": 10}}
{"res": {"only": 1}}
{"res": null}
