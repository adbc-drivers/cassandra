// part: metadata

[setup]
drop = "test_vector_float"

[tags]
sql-type-name = "VECTOR"
caveats = ["The driver can only bind CQL collections or vectors of float from Arrow float32 elements. Libraries such as PyArrow infer Python floating-point values as Arrow float64 by default; those inferred values cannot be bound directly."]

// part: setup_query

CREATE TABLE test_vector_float (
    pk INT,
    idx INT,
    res VECTOR<FLOAT, 4>,
    PRIMARY KEY (pk, idx)
);

// part: bind_query

INSERT INTO test_vector_float (pk, idx, res) VALUES (0, $1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: bind

{"idx": 1, "res": [0.1, 0.2, 0.3, 0.4]}
{"idx": 2, "res": [-1.0, 0.0, 1.0, 2.5]}
{"idx": 3, "res": null}

// part: query

SELECT res FROM test_vector_float WHERE pk = 0

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+w:4",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": [0.1, 0.2, 0.3, 0.4]}
{"res": [-1.0, 0.0, 1.0, 2.5]}
{"res": null}
