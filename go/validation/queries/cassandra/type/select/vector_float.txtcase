// part: metadata

[setup]
drop = "test_vector_float"

[tags]
sql-type-name = "VECTOR"

// Vector columns cannot be primary or clustering keys, so rows are ordered by
// a separate clustering key.

// part: setup_query

CREATE TABLE test_vector_float (
    pk INT,
    idx INT,
    res VECTOR<FLOAT, 4>,
    PRIMARY KEY (pk, idx)
);

INSERT INTO test_vector_float (pk, idx, res) VALUES (0, 1, [0.1, 0.2, 0.3, 0.4]);
INSERT INTO test_vector_float (pk, idx, res) VALUES (0, 2, [-1.0, 0.0, 1.0, 2.5]);
INSERT INTO test_vector_float (pk, idx, res) VALUES (0, 3, NULL);

// part: query

SELECT res FROM test_vector_float WHERE pk = 0

// part: catalog_schema

// GetTableSchema returns the whole table. The harness drops the first column
// (the pk partition key), leaving the clustering key idx and the res column.

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": ["nullable"]
        },
        {
            "name": "res",
            "format": "+w:4",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+w:4",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": [0.1, 0.2, 0.3, 0.4]}
{"res": [-1.0, 0.0, 1.0, 2.5]}
{"res": null}
