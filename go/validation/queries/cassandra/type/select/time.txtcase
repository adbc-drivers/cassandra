// part: metadata

sort-keys = [["res", "ascending"]]

// part: setup_query

CREATE TABLE test_time (
    idx INT PRIMARY KEY,
    res TIME
);

INSERT INTO test_time (idx, res) VALUES (1, '13:45:31.123456');
INSERT INTO test_time (idx, res) VALUES (2, '00:00:00');
INSERT INTO test_time (idx, res) VALUES (3, '23:59:59.999999');
INSERT INTO test_time (idx, res) VALUES (4, '12:30:45.500');
INSERT INTO test_time (idx, res) VALUES (5, NULL);

// part: query

SELECT res FROM test_time

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "ttn",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 49531123456000}
{"res": 0}
{"res": 86399999999000}
{"res": 45045500000000}
{"res": null}
