// part: metadata

[tags]
sql-type-name = "VECTOR"

// part: input_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "metadata": {"cassandra.kind": "partition_key"},
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "+w:4",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: input

{"idx": 0, "value": [0.1, 0.2, 0.3, 0.4]}
{"idx": 1, "value": [-1.0, 0.0, 1.0, 2.5]}
{"idx": 2, "value": null}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "+w:4",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "f",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"idx": 0, "value": [0.1, 0.2, 0.3, 0.4]}
{"idx": 1, "value": [-1.0, 0.0, 1.0, 2.5]}
{"idx": 2, "value": null}
