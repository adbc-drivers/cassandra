// part: metadata

[tags]
sql-type-name = "BLOB"

// part: setup_query

CREATE TABLE test_binary_view (
    idx INT PRIMARY KEY,
    res BLOB
);

// part: bind_query

INSERT INTO test_binary_view (idx, res) VALUES ($1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "vz",
            "flags": ["nullable"]
        }
    ]
}

// part: bind

{"idx": 0, "res": "44GT44KT44Gr44Gh44Gv44CB5LiW55WM77yB"}
{"idx": 1, "res": "AA=="}
{"idx": 2, "res": "AQAC"}
{"idx": 3, "res": "3q2+7w=="}
{"idx": 4, "res": ""}
{"idx": 5, "res": null}

// part: query

SELECT res FROM test_binary_view
