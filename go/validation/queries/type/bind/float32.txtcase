// part: metadata

[tags]
sql-type-name = "FLOAT"

// part: setup_query

CREATE TABLE test_float32 (
    idx INT PRIMARY KEY,
    res FLOAT
);

// part: bind_query

INSERT INTO test_float32 (idx, res) VALUES ($1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "f",
            "flags": ["nullable"]
        }
    ]
}

// part: bind

{"idx": 0, "res": 3.14159}
{"idx": 1, "res": -2.5}
{"idx": 2, "res": 0.0}
{"idx": 3, "res": 3.4028235e+38}
{"idx": 4, "res": -3.4028235e+38}
{"idx": 5, "res": null}

// part: query

SELECT res FROM test_float32
