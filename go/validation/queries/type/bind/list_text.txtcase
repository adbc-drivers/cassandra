// part: metadata

[setup]
drop = "test_list_text"

[tags]
sql-type-name = "LIST"

// part: setup_query

CREATE TABLE test_list_text (
    pk INT,
    idx INT,
    res LIST<TEXT>,
    PRIMARY KEY (pk, idx)
);

// part: bind_query

INSERT INTO test_list_text (pk, idx, res) VALUES (0, $1, $2)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": []
        },
        {
            "name": "res",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: bind

{"idx": 1, "res": ["a", "b", "c"]}
{"idx": 2, "res": ["single"]}
{"idx": 3, "res": null}

// part: query

SELECT res FROM test_list_text WHERE pk = 0

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": ["a", "b", "c"]}
{"res": ["single"]}
{"res": null}
