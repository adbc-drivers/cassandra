// part: metadata

sort-keys = [["res", "ascending"]]

[setup]
drop = "test_timestamp"

// part: setup_query

CREATE TABLE test_timestamp (
    idx INT PRIMARY KEY,
    res TIMESTAMP
);

INSERT INTO test_timestamp (idx, res) VALUES (1, '2023-05-15 13:45:30+0000');
INSERT INTO test_timestamp (idx, res) VALUES (2, '2000-01-01 00:00:00+0000');
INSERT INTO test_timestamp (idx, res) VALUES (3, '1969-07-20 20:17:40+0000');
INSERT INTO test_timestamp (idx, res) VALUES (4, '9999-12-31 23:59:59+0000');
INSERT INTO test_timestamp (idx, res) VALUES (5, NULL);

// part: query

SELECT res FROM test_timestamp

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330000}
{"res": 946684800000}
{"res": -14182940000}
{"res": 253402300799000}
{"res": null}
