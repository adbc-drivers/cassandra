// part: metadata

[setup]
drop = "test_map_text_int"

[tags]
sql-type-name = "MAP"
caveats = ["The order of entries within a map value is not deterministic: the underlying gocql driver unmarshals a CQL map into a Go map, whose iteration order is randomized. All keys and values are returned correctly, but two identical queries may return a map's entries in a different order."]

// map<K,V> maps to an Arrow map. Single-entry maps are used because gocql
// unmarshals a CQL map into a Go map, whose iteration order is randomized, so
// multi-entry maps would come back in a nondeterministic order. A collection
// column (MAP) cannot be used as a sort key, so results are ordered by a clustering
// key: all rows share one partition and are returned in ascending clustering
// order.

// part: setup_query

CREATE TABLE test_map_text_int (
    pk INT,
    idx INT,
    res MAP<TEXT, INT>,
    PRIMARY KEY (pk, idx)
);

INSERT INTO test_map_text_int (pk, idx, res) VALUES (0, 1, {'x': 10});
INSERT INTO test_map_text_int (pk, idx, res) VALUES (0, 2, {'only': 1});
INSERT INTO test_map_text_int (pk, idx, res) VALUES (0, 3, NULL);

// part: query

SELECT res FROM test_map_text_int WHERE pk = 0

// part: catalog_schema

// GetTableSchema returns the whole table. The harness drops the first column
// (the pk partition key), leaving the clustering key idx and the res column.

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "i",
            "flags": ["nullable"]
        },
        {
            "name": "res",
            "format": "+m",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "key",
                    "format": "u",
                    "flags": []
                },
                {
                    "name": "value",
                    "format": "i",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+m",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "key",
                    "format": "u",
                    "flags": []
                },
                {
                    "name": "value",
                    "format": "i",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": {"x": 10}}
{"res": {"only": 1}}
{"res": null}
